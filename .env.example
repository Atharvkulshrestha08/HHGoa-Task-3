# ====================================================================
# Face ID + Blockchain Verification Pipeline - Configuration
# ====================================================================

# 1. Reverse Image Search (SerpAPI - Google Lens)
# Get a free API key at: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_api_key_here

# 2. Blockchain RPC Endpoint (Ethereum Sepolia, Base Sepolia, Polygon Amoy)
# Get a free endpoint from Infura (https://infura.io) or Alchemy (https://alchemy.com) or use public RPC
WEB3_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 3. Wallet Private Key (EVM Testnet account funded with Sepolia ETH)
# Faucet: https://sepoliafaucet.com or https://www.alchemy.com/faucets/ethereum-sepolia
PRIVATE_KEY=your_testnet_private_key_without_0x_prefix

# 4. Smart Contract Address (Optional - if deployed; otherwise uses raw calldata notarization)
CONTRACT_ADDRESS=

# 5. Blockchain Network Selection: 'sepolia', 'base_sepolia', 'amoy', or 'local'
BLOCKCHAIN_NETWORK=sepolia
